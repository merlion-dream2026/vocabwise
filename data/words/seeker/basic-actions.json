{"id":"basic-actions","name":"Hành Động","emoji":"🏃","color":"orange","words":[{"word":"run","ipa":"/rʌn/","meaning":"chạy","emoji":"🏃","class":"v","examples":[{"en":"I run in the park.","vi":"Tôi chạy trong công viên."},{"en":"Run fast!","vi":"Chạy nhanh lên!"}]},{"word":"jump","ipa":"/dʒʌmp/","meaning":"nhảy","emoji":"🦘","class":"v","examples":[{"en":"I jump over the puddle.","vi":"Tôi nhảy qua vũng nước."},{"en":"Jump high!","vi":"Nhảy cao lên!"}]},{"word":"walk","ipa":"/wɔk/","meaning":"đi bộ","emoji":"🚶","class":"v","examples":[{"en":"I walk to school.","vi":"Tôi đi bộ đến trường."},{"en":"Walk slowly.","vi":"Đi chậm thôi."}]},{"word":"eat","ipa":"/it/","meaning":"ăn","emoji":"🥢","class":"v","examples":[{"en":"I eat rice.","vi":"Tôi ăn cơm."},{"en":"Eat your food.","vi":"Ăn thức ăn đi nào."}]},{"word":"drink","ipa":"/drɪŋk/","meaning":"uống","emoji":"🥤","class":"v","examples":[{"en":"I drink water.","vi":"Tôi uống nước."},{"en":"Drink your milk.","vi":"Uống sữa đi nào."}]},{"word":"sleep","ipa":"/slip/","meaning":"ngủ","emoji":"😴","class":"v","examples":[{"en":"I sleep at night.","vi":"Tôi ngủ vào ban đêm."},{"en":"Sleep now.","vi":"Ngủ đi."}]},{"word":"play","ipa":"/pleɪ/","meaning":"chơi","emoji":"🎪","class":"v","examples":[{"en":"I play with my toys.","vi":"Tôi chơi với đồ chơi."},{"en":"Let's play together.","vi":"Cùng chơi nào!"}]},{"word":"draw","ipa":"/drɔ/","meaning":"vẽ","emoji":"🖌️","class":"v","examples":[{"en":"I draw a cat.","vi":"Tôi vẽ một con mèo."},{"en":"Draw a big circle.","vi":"Hãy vẽ một hình tròn to."}]},{"word":"sing","ipa":"/sɪŋ/","meaning":"hát","emoji":"🎤","class":"v","examples":[{"en":"I sing a song.","vi":"Tôi hát một bài hát."},{"en":"Let's sing together.","vi":"Cùng hát nào!"}]},{"word":"dance","ipa":"/dæns/","meaning":"nhảy múa","emoji":"💃","class":"v","examples":[{"en":"I dance to the music.","vi":"Tôi nhảy theo nhạc."},{"en":"She dances very well.","vi":"Cô ấy nhảy rất giỏi."}]},{"word":"swim","ipa":"/swɪm/","meaning":"bơi","emoji":"🏊","class":"v","examples":[{"en":"I swim in the pool.","vi":"Tôi bơi trong hồ bơi."},{"en":"Fish swim in water.","vi":"Cá bơi trong nước."}]},{"word":"kick","ipa":"/kɪk/","meaning":"đá","emoji":"🤸","class":"v","examples":[{"en":"I kick the ball.","vi":"Tôi đá quả bóng."},{"en":"Kick it hard!","vi":"Đá mạnh vào!"}]},{"word":"throw","ipa":"/θroʊ/","meaning":"ném","emoji":"🤾","class":"v","examples":[{"en":"I throw the ball.","vi":"Tôi ném quả bóng."},{"en":"Throw it to me!","vi":"Ném cho tôi đi!"}]},{"word":"look","ipa":"/lʊk/","meaning":"nhìn","emoji":"👀","class":"v","examples":[{"en":"Look at the bird!","vi":"Nhìn con chim kìa!"},{"en":"I look out the window.","vi":"Tôi nhìn ra ngoài cửa sổ."}]},{"word":"open","ipa":"/ˈoʊpən/","meaning":"mở","emoji":"🔓","class":"v","examples":[{"en":"Open the door please.","vi":"Mở cửa ra đi."},{"en":"I open my bag.","vi":"Tôi mở cặp ra."}]}]}