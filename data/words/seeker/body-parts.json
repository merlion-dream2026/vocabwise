{"id":"body-parts","name":"Cơ Thể","emoji":"🧍","color":"orange","words":[{"word":"head","meaning":"đầu","emoji":"🙂","class":"n","examples":[{"en":"I touch my head.","vi":"Tôi chạm vào đầu mình."},{"en":"She shakes her head.","vi":"Cô ấy lắc đầu."}]},{"word":"eye","meaning":"mắt","emoji":"👁️","class":"n","examples":[{"en":"I have two eyes.","vi":"Tôi có hai mắt."},{"en":"Her eyes are brown.","vi":"Mắt cô ấy màu nâu."}]},{"word":"ear","meaning":"tai","emoji":"👂","class":"n","examples":[{"en":"I hear with my ears.","vi":"Tôi nghe bằng tai."},{"en":"The rabbit has big ears.","vi":"Con thỏ có đôi tai to."}]},{"word":"nose","meaning":"mũi","emoji":"👃","class":"n","examples":[{"en":"I smell with my nose.","vi":"Tôi ngửi bằng mũi."},{"en":"The clown has a red nose.","vi":"Chú hề có cái mũi đỏ."}]},{"word":"mouth","meaning":"miệng","emoji":"👄","class":"n","examples":[{"en":"I eat with my mouth.","vi":"Tôi ăn bằng miệng."},{"en":"Open your mouth wide.","vi":"Mở miệng to ra nào."}]},{"word":"hand","meaning":"bàn tay","emoji":"✋","class":"n","examples":[{"en":"I wave my hand.","vi":"Tôi vẫy tay."},{"en":"Wash your hands, please.","vi":"Hãy rửa tay đi nào."}]},{"word":"foot","meaning":"bàn chân","emoji":"🦶","class":"n","examples":[{"en":"I kick with my foot.","vi":"Tôi đá bằng bàn chân."},{"en":"My foot hurts today.","vi":"Hôm nay bàn chân tôi đau."}]},{"word":"arm","meaning":"cánh tay","emoji":"💪","class":"n","examples":[{"en":"I hug with my arms.","vi":"Tôi ôm bằng cánh tay."},{"en":"My arm is strong.","vi":"Cánh tay tôi rất khỏe."}]},{"word":"leg","meaning":"chân","emoji":"🦵","class":"n","examples":[{"en":"I run with my legs.","vi":"Tôi chạy bằng đôi chân."},{"en":"She has long legs.","vi":"Cô ấy có đôi chân dài."}]},{"word":"hair","meaning":"tóc","emoji":"💇","class":"n","examples":[{"en":"My hair is black.","vi":"Tóc tôi màu đen."},{"en":"She has long hair.","vi":"Cô ấy có mái tóc dài."}]}]}