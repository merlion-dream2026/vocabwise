{"id":"daily-routines","name":"Sinh Hoạt Hàng Ngày","emoji":"🌅","color":"yellow","words":[{"word":"wake","meaning":"thức dậy","emoji":"⏰","class":"v","examples":[{"en":"I wake up at seven.","vi":"Tôi thức dậy lúc bảy giờ."},{"en":"Wake up, it is morning!","vi":"Dậy đi, trời sáng rồi!"}]},{"word":"wash","meaning":"rửa/tắm","emoji":"🫧","class":"v","examples":[{"en":"I wash my hands.","vi":"Tôi rửa tay."},{"en":"Wash your face.","vi":"Rửa mặt đi."}]},{"word":"brush","meaning":"chải/đánh","emoji":"🪥","class":"v","examples":[{"en":"I brush my teeth.","vi":"Tôi đánh răng."},{"en":"Brush your hair.","vi":"Chải tóc đi."}]},{"word":"wear","meaning":"mặc/đeo","emoji":"👘","class":"v","examples":[{"en":"I wear my school uniform.","vi":"Tôi mặc đồng phục đi học."},{"en":"Wear your jacket.","vi":"Mặc áo khoác vào."}]},{"word":"morning","meaning":"buổi sáng","emoji":"🌅","class":"n","examples":[{"en":"Good morning!","vi":"Chào buổi sáng!"},{"en":"I eat breakfast in the morning.","vi":"Tôi ăn sáng vào buổi sáng."}]},{"word":"school","meaning":"trường học","emoji":"🏫","class":"n","examples":[{"en":"I go to school every day.","vi":"Tôi đi học mỗi ngày."},{"en":"I love my school.","vi":"Tôi yêu trường tôi."}]},{"word":"lunch","meaning":"bữa trưa","emoji":"🍱","class":"n","examples":[{"en":"I eat lunch at noon.","vi":"Tôi ăn trưa vào buổi trưa."},{"en":"I bring lunch to school.","vi":"Tôi mang cơm hộp đi học."}]},{"word":"rest","meaning":"nghỉ ngơi","emoji":"💤","class":"v","examples":[{"en":"I rest after school.","vi":"Tôi nghỉ ngơi sau khi học."},{"en":"Rest now.","vi":"Nghỉ ngơi đi."}]},{"word":"bath","meaning":"tắm","emoji":"🛁","class":"n","examples":[{"en":"I take a bath every day.","vi":"Tôi tắm mỗi ngày."},{"en":"The bath is warm.","vi":"Nước tắm ấm."}]},{"word":"dinner","meaning":"bữa tối","emoji":"🍲","class":"n","examples":[{"en":"We eat dinner together.","vi":"Chúng tôi ăn tối cùng nhau."},{"en":"Dinner is my favorite meal.","vi":"Bữa tối là bữa ăn tôi thích nhất."}]},{"word":"night","meaning":"buổi tối/đêm","emoji":"🌙","class":"n","examples":[{"en":"Good night!","vi":"Chúc ngủ ngon!"},{"en":"Stars come out at night.","vi":"Sao xuất hiện vào ban đêm."}]},{"word":"study","meaning":"học/học bài","emoji":"📓","class":"v","examples":[{"en":"I study every day.","vi":"Tôi học bài mỗi ngày."},{"en":"I study after dinner.","vi":"Tôi học bài sau bữa tối."}]},{"word":"cook","meaning":"nấu ăn","emoji":"🔥","class":"v","examples":[{"en":"Mum cooks dinner.","vi":"Mẹ nấu bữa tối."},{"en":"I cook rice.","vi":"Tôi nấu cơm."}]},{"word":"come","meaning":"đến/về","emoji":"↩️","class":"v","examples":[{"en":"I come home at five.","vi":"Tôi về nhà lúc năm giờ."},{"en":"Come here!","vi":"Lại đây!"}]},{"word":"go","meaning":"đi","emoji":"➡️","class":"v","examples":[{"en":"I go to school.","vi":"Tôi đi học."},{"en":"Go now!","vi":"Đi thôi!"}]}]}