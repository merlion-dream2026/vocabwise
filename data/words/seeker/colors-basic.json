{"id":"colors-basic","name":"Màu Sắc","emoji":"🌈","color":"red","words":[{"word":"red","ipa":"/red/","meaning":"màu đỏ","emoji":"🔴","class":"adj","examples":[{"en":"I see a red ball.","vi":"Tôi thấy một quả bóng màu đỏ."},{"en":"The apple is red.","vi":"Quả táo màu đỏ."}]},{"word":"blue","ipa":"/blu/","meaning":"màu xanh dương","emoji":"🔵","class":"adj","examples":[{"en":"The sky is blue.","vi":"Bầu trời màu xanh dương."},{"en":"I like the blue shirt.","vi":"Tôi thích cái áo màu xanh dương."}]},{"word":"green","ipa":"/ɡrin/","meaning":"màu xanh lá","emoji":"🟢","class":"adj","examples":[{"en":"Grass is green.","vi":"Cỏ màu xanh lá."},{"en":"I see a green tree.","vi":"Tôi thấy một cây màu xanh lá."}]},{"word":"yellow","ipa":"/ˈjeloʊ/","meaning":"màu vàng","emoji":"🟡","class":"adj","examples":[{"en":"The sun is yellow.","vi":"Mặt trời màu vàng."},{"en":"I have a yellow pencil.","vi":"Tôi có một cây bút màu vàng."}]},{"word":"pink","ipa":"/pɪŋk/","meaning":"màu hồng","emoji":"🩷","class":"adj","examples":[{"en":"The flower is pink.","vi":"Bông hoa màu hồng."},{"en":"I love pink.","vi":"Tôi thích màu hồng."}]},{"word":"orange","ipa":"/ˈɔrəndʒ/","meaning":"màu cam","emoji":"🟠","class":"adj","examples":[{"en":"The cat has orange fur.","vi":"Con mèo có bộ lông màu cam."},{"en":"I draw an orange sun.","vi":"Tôi vẽ một mặt trời màu cam."}]},{"word":"black","ipa":"/blæk/","meaning":"màu đen","emoji":"⚫","class":"adj","examples":[{"en":"My cat is black.","vi":"Con mèo của tôi màu đen."},{"en":"I write with a black pen.","vi":"Tôi viết bằng bút màu đen."}]},{"word":"white","ipa":"/waɪt/","meaning":"màu trắng","emoji":"⚪","class":"adj","examples":[{"en":"Snow is white.","vi":"Tuyết màu trắng."},{"en":"I have a white rabbit.","vi":"Tôi có một con thỏ màu trắng."}]},{"word":"brown","ipa":"/braʊn/","meaning":"màu nâu","emoji":"🟫","class":"adj","examples":[{"en":"The bear is brown.","vi":"Con gấu màu nâu."},{"en":"I see a brown dog.","vi":"Tôi thấy một con chó màu nâu."}]},{"word":"gr