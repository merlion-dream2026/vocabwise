{"id":"toys-games","name":"Đồ Chơi","emoji":"🧸","color":"pink","words":[{"word":"ball","meaning":"quả bóng","emoji":"🎱","class":"n","examples":[{"en":"I kick the ball.","vi":"Tôi đá quả bóng."},{"en":"The ball is round.","vi":"Quả bóng có hình tròn."}]},{"word":"doll","meaning":"búp bê","emoji":"🪆","class":"n","examples":[{"en":"I have a pretty doll.","vi":"Tôi có một con búp bê đẹp."},{"en":"My doll has long hair.","vi":"Con búp bê của tôi có tóc dài."}]},{"word":"kite","meaning":"diều","emoji":"🪁","class":"n","examples":[{"en":"I fly my kite.","vi":"Tôi thả diều."},{"en":"The kite flies high.","vi":"Con diều bay cao."}]},{"word":"puzzle","meaning":"trò chơi xếp hình","emoji":"🧩","class":"n","examples":[{"en":"I do a puzzle.","vi":"Tôi chơi xếp hình."},{"en":"The puzzle has many pieces.","vi":"Trò chơi xếp hình có nhiều mảnh."}]},{"word":"block","meaning":"khối xây dựng","emoji":"🎲","class":"n","examples":[{"en":"I build with blocks.","vi":"Tôi xây bằng khối."},{"en":"The blocks are colorful.","vi":"Các khối rất nhiều màu sắc."}]},{"word":"teddy","meaning":"gấu bông","emoji":"🧸","class":"n","examples":[{"en":"I hug my teddy.","vi":"Tôi ôm con gấu bông."},{"en":"My teddy is soft.","vi":"Con gấu bông của tôi rất mềm."}]},{"word":"marble","meaning":"bi thủy tinh","emoji":"🔮","class":"n","examples":[{"en":"I play with marbles.","vi":"Tôi chơi bi."},{"en":"The marble is round.","vi":"Viên bi có hình tròn."}]},{"word":"drum","meaning":"trống","emoji":"🥁","class":"n","examples":[{"en":"I play the drum.","vi":"Tôi đánh trống."},{"en":"The drum is loud.","vi":"Tiếng trống rất to."}]},{"word":"robot","meaning":"rô bốt","emoji":"🤖","class":"n","examples":[{"en":"I play with my robot.","vi":"Tôi chơi với rô bốt."},{"en":"My robot can walk.","vi":"Rô bốt của tôi có thể đi."}]},{"word":"yo-yo","meaning":"yo-yo","emoji":"🪀","class":"n","examples":[{"en":"I play with my yo-yo.","vi":"Tôi chơi yo-yo."},{"en":"The yo-yo goes up and down.","vi":"Yo-yo đi lên đi xuống."}]},{"word":"sticker","meaning":"nhãn dán","emoji":"🏷️","class":"n","examples":[{"en":"I put a star sticker on my book.","vi":"Tôi dán nhãn ngôi sao lên sách."},{"en":"I love my star stickers.","vi":"Tôi thích các nhãn dán ngôi sao."}]},{"word":"clay","meaning":"đất nặn","emoji":"🪣","class":"n","examples":[{"en":"I make a cat with clay.","vi":"Tôi nặn con mèo bằng đất nặn."},{"en":"Clay is soft.","vi":"Đất nặn rất mềm."}]},{"word":"whistle","meaning":"còi","emoji":"🎵","class":"n","examples":[{"en":"The teacher blows the whistle.","vi":"Giáo viên thổi còi."},{"en":"I have a red whistle.","vi":"Tôi có một cái còi đỏ."}]},{"word":"frisbee","meaning":"đĩa ném","emoji":"🥏","class":"n","examples":[{"en":"I throw the frisbee.","vi":"Tôi ném đĩa frisbee."},{"en":"We play frisbee in the park.","vi":"Chúng tôi chơi frisbee trong công viên."}]},{"word":"spinner","meaning":"con quay","emoji":"🌀","class":"n","examples":[{"en":"I spin my spinner.","vi":"Tôi quay con quay."},{"en":"The spinner goes round and round.","vi":"Con quay quay tròn mãi."}]}]}