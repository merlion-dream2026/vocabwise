{"id":"basic-vegetables","name":"Rau Củ","emoji":"🥦","color":"green","words":[{"word":"carrot","ipa":"/ˈkærət/","meaning":"cà rốt","emoji":"🥕","class":"n","examples":[{"en":"The carrot is orange.","vi":"Củ cà rốt màu cam."},{"en":"My rabbit eats carrots.","vi":"Con thỏ của tôi ăn cà rốt."}]},{"word":"tomato","ipa":"/təˈmeɪˌtoʊ/","meaning":"cà chua","emoji":"🍅","class":"n","examples":[{"en":"The tomato is red.","vi":"Quả cà chua màu đỏ."},{"en":"I eat tomatoes in salad.","vi":"Tôi ăn cà chua trong salad."}]},{"word":"potato","ipa":"/pəˈteɪˌtoʊ/","meaning":"khoai tây","emoji":"🥔","class":"n","examples":[{"en":"I eat potato chips.","vi":"Tôi ăn khoai tây chiên."},{"en":"The potato is brown.","vi":"Củ khoai tây màu nâu."}]},{"word":"onion","ipa":"/ˈʌnjən/","meaning":"hành tây","emoji":"🧅","class":"n","examples":[{"en":"Onion makes me cry.","vi":"Hành tây làm tôi chảy nước mắt."},{"en":"Mum cooks with onion.","vi":"Mẹ nấu ăn với hành tây."}]},{"word":"corn","ipa":"/kɔrn/","meaning":"ngô/bắp","emoji":"🌽","class":"n","examples":[{"en":"I eat sweet corn.","vi":"Tôi ăn ngô ngọt."},{"en":"The corn is yellow.","vi":"Bắp ngô màu vàng."}]},{"word":"bean","ipa":"/bin/","meaning":"đậu","emoji":"🫘","class":"n","examples":[{"en":"I eat green beans.","vi":"Tôi ăn đậu xanh."},{"en":"Beans are good for me.","vi":"Đậu rất tốt cho sức khỏe."}]},{"word":"pea","ipa":"/pi/","meaning":"đậu Hà Lan","emoji":"🫛","class":"n","examples":[{"en":"Peas are small and green.","vi":"Đậu Hà Lan nhỏ và màu xanh."},{"en":"I eat peas with rice.","vi":"Tôi ăn đậu Hà Lan với cơm."}]},{"word":"cabbage","ipa":"/ˈkæbədʒ/","meaning":"bắp cải","emoji":"🥬","class":"n","examples":[{"en":"The cabbage is green.","vi":"Bắp cải màu xanh."},{"en":"I eat cabbage soup.","vi":"Tôi ăn canh bắp cải."}]},{"word":"cucumber","ipa":"/ˈkjukəmbər/","meaning":"dưa chuột","emoji":"🥒","class":"n","examples":[{"en":"The cucumber is long and green.","vi":"Quả dưa chuột dài và màu xanh."},{"en":"I eat cucumber in salad.","vi":"Tôi ăn dưa chuột trong salad."}]},{"word":"mushroom","ipa":"/ˈmʌʃrum/","meaning":"nấm","emoji":"🍄","class":"n","examples":[{"en":"The mushroom is white.","vi":"Cây nấm màu trắng."},{"en":"I eat mushroom soup.","vi":"Tôi ăn canh nấm."}]},{"word":"pumpkin","ipa":"/ˈpʌmpkɪn/","meaning":"bí ngô","emoji":"🎃","class":"n","examples":[{"en":"The pumpkin is orange.","vi":"Quả bí ngô màu cam."},{"en":"I eat pumpkin soup.","vi":"Tôi ăn canh bí ngô."}]},{"word":"garlic","ipa":"/ˈɡɑrlɪk/","meaning":"tỏi","emoji":"🧄","class":"n","examples":[{"en":"Mum uses garlic to cook.","vi":"Mẹ dùng tỏi để nấu ăn."},{"en":"Garlic has a strong smell.","vi":"Tỏi có mùi rất nồng."}]},{"word":"ginger","ipa":"/ˈdʒɪndʒər/","meaning":"gừng","emoji":"🫚","class":"n","examples":[{"en":"I drink ginger tea.","vi":"Tôi uống trà gừng."},{"en":"Ginger is spicy.","vi":"Gừng có vị cay."}]},{"word":"spinach","ipa":"/ˈspɪnətʃ/","meaning":"rau bina","emoji":"🥗","class":"n","examples":[{"en":"Spinach is green.","vi":"Rau bina màu xanh."},{"en":"I eat spinach to be strong.","vi":"Tôi ăn rau bina để khỏe mạnh."}]},{"word":"chili","ipa":"/ˈtʃɪli/","meaning":"ớt","emoji":"🌶️","class":"n","examples":[{"en":"The chili is very spicy.","vi":"Quả ớt rất cay."},{"en":"Chili is red.","vi":"Ớt màu đỏ."}]}]}