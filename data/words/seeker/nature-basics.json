{"id":"nature-basics","name":"Thiên Nhiên","emoji":"🌿","color":"green","words":[{"word":"tree","meaning":"cây","emoji":"🌳","class":"n","examples":[{"en":"The tree is tall.","vi":"Cây rất cao."},{"en":"Birds live in trees.","vi":"Chim sống trên cây."}]},{"word":"flower","meaning":"hoa","emoji":"🌸","class":"n","examples":[{"en":"The flower is pink.","vi":"Bông hoa màu hồng."},{"en":"I pick a flower for mum.","vi":"Tôi hái một bông hoa tặng mẹ."}]},{"word":"grass","meaning":"cỏ","emoji":"🌿","class":"n","examples":[{"en":"The grass is green.","vi":"Cỏ màu xanh lá."},{"en":"I sit on the grass.","vi":"Tôi ngồi trên cỏ."}]},{"word":"leaf","meaning":"lá cây","emoji":"🍃","class":"n","examples":[{"en":"The leaf is green.","vi":"Chiếc lá màu xanh."},{"en":"I find a big leaf.","vi":"Tôi tìm thấy một chiếc lá to."}]},{"word":"rock","meaning":"hòn đá","emoji":"🪨","class":"n","examples":[{"en":"I sit on a big rock.","vi":"Tôi ngồi trên hòn đá to."},{"en":"The rock is hard.","vi":"Hòn đá rất cứng."}]},{"word":"river","meaning":"sông","emoji":"🌊","class":"n","examples":[{"en":"The river is long.","vi":"Con sông rất dài."},{"en":"Fish swim in the river.","vi":"Cá bơi trong sông."}]},{"word":"lake","meaning":"hồ","emoji":"🏞️","class":"n","examples":[{"en":"The lake is blue.","vi":"Hồ nước màu xanh."},{"en":"We swim in the lake.","vi":"Chúng tôi bơi trong hồ."}]},{"word":"hill","meaning":"đồi","emoji":"⛰️","class":"n","examples":[{"en":"I climb the hill.","vi":"Tôi leo lên đồi."},{"en":"The hill is green.","vi":"Đồi màu xanh."}]},{"word":"sky","meaning":"bầu trời","emoji":"🌤️","class":"n","examples":[{"en":"The sky is blue.","vi":"Bầu trời màu xanh."},{"en":"I look at the sky.","vi":"Tôi nhìn lên bầu trời."}]},{"word":"sand","meaning":"cát","emoji":"🏖️","class":"n","examples":[{"en":"I play in the sand.","vi":"Tôi chơi trên cát."},{"en":"Sand is soft.","vi":"Cát mềm mại."}]},{"word":"beach","meaning":"bãi biển","emoji":"🏝️","class":"n","examples":[{"en":"I play at the beach.","vi":"Tôi chơi ở bãi biển."},{"en":"The beach has white sand.","vi":"Bãi biển có cát trắng."}]},{"word":"forest","meaning":"rừng","emoji":"🌲","class":"n","examples":[{"en":"Animals live in the forest.","vi":"Động vật sống trong rừng."},{"en":"The forest is dark.","vi":"Rừng tối và rậm."}]},{"word":"mountain","meaning":"núi","emoji":"🏔️","class":"n","examples":[{"en":"The mountain is very high.","vi":"Núi rất cao."},{"en":"I see snow on the mountain.","vi":"Tôi thấy tuyết trên núi."}]},{"word":"path","meaning":"con đường/lối đi","emoji":"🛤️","class":"n","examples":[{"en":"I walk on the path.","vi":"Tôi đi trên con đường."},{"en":"The path goes to the river.","vi":"Con đường dẫn đến sông."}]},{"word":"bush","meaning":"bụi cây","emoji":"🪴","class":"n","examples":[{"en":"The rabbit hides in the bush.","vi":"Con thỏ ẩn trong bụi cây."},{"en":"There are flowers on the bush.","vi":"Có hoa trên bụi cây."}]}]}