{"id":"basic-transport","name":"Phương Tiện","emoji":"🚗","color":"blue","words":[{"word":"car","meaning":"ô tô","emoji":"🚗","class":"n","examples":[{"en":"My dad drives a car.","vi":"Bố tôi lái ô tô."},{"en":"The car is red.","vi":"Chiếc ô tô màu đỏ."}]},{"word":"bus","meaning":"xe buýt","emoji":"🚌","class":"n","examples":[{"en":"I go to school by bus.","vi":"Tôi đi học bằng xe buýt."},{"en":"The bus is big and yellow.","vi":"Xe buýt to và màu vàng."}]},{"word":"train","meaning":"tàu hỏa","emoji":"🚂","class":"n","examples":[{"en":"The train is very fast.","vi":"Tàu hỏa chạy rất nhanh."},{"en":"I ride the train.","vi":"Tôi đi tàu hỏa."}]},{"word":"plane","meaning":"máy bay","emoji":"✈️","class":"n","examples":[{"en":"The plane flies in the sky.","vi":"Máy bay bay trên bầu trời."},{"en":"I want to ride a plane.","vi":"Tôi muốn đi máy bay."}]},{"word":"bike","meaning":"xe đạp","emoji":"🚲","class":"n","examples":[{"en":"I ride my bike to school.","vi":"Tôi đạp xe đi học."},{"en":"My bike is blue.","vi":"Xe đạp của tôi màu xanh."}]},{"word":"boat","meaning":"thuyền","emoji":"⛵","class":"n","examples":[{"en":"The boat is on the river.","vi":"Con thuyền ở trên sông."},{"en":"I ride a small boat.","vi":"Tôi đi thuyền nhỏ."}]},{"word":"taxi","meaning":"xe taxi","emoji":"🚕","class":"n","examples":[{"en":"We take a taxi home.","vi":"Chúng tôi đi taxi về nhà."},{"en":"The taxi is yellow.","vi":"Xe taxi màu vàng."}]},{"word":"truck","meaning":"xe tải","emoji":"🚚","class":"n","examples":[{"en":"The truck carries boxes.","vi":"Xe tải chở hàng hóa."},{"en":"That truck is very big.","vi":"Chiếc xe tải đó rất to."}]},{"word":"ship","meaning":"tàu thủy","emoji":"🚢","class":"n","examples":[{"en":"The ship sails on the sea.","vi":"Tàu thủy chạy trên biển."},{"en":"I see a big ship.","vi":"Tôi thấy một con tàu to."}]},{"word":"helicopter","meaning":"trực thăng","emoji":"🚁","class":"n","examples":[{"en":"The helicopter flies up high.","vi":"Trực thăng bay lên cao."},{"en":"I see a red helicopter.","vi":"Tôi thấy một chiếc trực thăng đỏ."}]}]}