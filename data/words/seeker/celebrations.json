{"id":"celebrations","name":"Lễ Hội & Tiệc","emoji":"🎉","color":"pink","words":[{"word":"birthday","ipa":"/ˈbɜrθˌdeɪ/","meaning":"sinh nhật","emoji":"🎂","class":"n","examples":[{"en":"Today is my birthday.","vi":"Hôm nay là sinh nhật của tôi."},{"en":"Happy birthday to you!","vi":"Chúc mừng sinh nhật!"}]},{"word":"party","ipa":"/ˈpɑrti/","meaning":"bữa tiệc","emoji":"🎉","class":"n","examples":[{"en":"I go to a party.","vi":"Tôi đi dự tiệc."},{"en":"The party is fun.","vi":"Bữa tiệc rất vui."}]},{"word":"gift","ipa":"/ɡɪft/","meaning":"quà tặng","emoji":"🎁","class":"n","examples":[{"en":"I get a gift.","vi":"Tôi nhận được quà."},{"en":"I give my friend a gift.","vi":"Tôi tặng quà cho bạn."}]},{"word":"candle","ipa":"/ˈkændəl/","meaning":"nến","emoji":"🕯️","class":"n","examples":[{"en":"I blow out the candles.","vi":"Tôi thổi tắt nến."},{"en":"There are five candles on the cake.","vi":"Có năm cây nến trên bánh."}]},{"word":"firework","ipa":"/ˈfaɪrˌwɜrk/","meaning":"pháo hoa","emoji":"🎆","class":"n","examples":[{"en":"I see fireworks in the sky.","vi":"Tôi thấy pháo hoa trên bầu trời."},{"en":"Fireworks are colorful.","vi":"Pháo hoa rất nhiều màu."}]},{"word":"costume","ipa":"/kɑˈstum/","meaning":"trang phục hóa trang","emoji":"🎭","class":"n","examples":[{"en":"I wear a costume.","vi":"Tôi mặc trang phục hóa trang."},{"en":"My costume is a dragon.","vi":"Trang phục của tôi là con rồng."}]},{"word":"lantern","ipa":"/ˈlæntərn/","meaning":"đèn lồng","emoji":"🏮","class":"n","examples":[{"en":"I carry a lantern.","vi":"Tôi mang đèn lồng."},{"en":"The lantern is red.","vi":"Đèn lồng màu đỏ."}]},{"word":"parade","ipa":"/pəˈreɪd/","meaning":"diễu hành","emoji":"🎺","class":"n","examples":[{"en":"I watch the parade.","vi":"Tôi xem diễu hành."},{"en":"The parade is colorful.","vi":"Đoàn diễu hành rất nhiều màu sắc."}]},{"word":"cheer","ipa":"/tʃɪr/","meaning":"hò reo","emoji":"🙌","class":"v","examples":[{"en":"We cheer for our team.","vi":"Chúng tôi hò reo cổ vũ đội mình."},{"en":"Cheer loudly!","vi":"Hò reo to lên nào!"}]},{"word":"clap","ipa":"/klæp/","meaning":"vỗ tay","emoji":"👏","class":"v","examples":[{"en":"I clap my hands.","vi":"Tôi vỗ tay."},{"en":"Clap for the singer!","vi":"Vỗ tay cho ca sĩ nào!"}]},{"word":"countdown","ipa":"/ˈkaʊntˌdaʊn/","meaning":"đếm ngược","emoji":"⏱️","class":"n","examples":[{"en":"We do a countdown.","vi":"Chúng tôi đếm ngược."},{"en":"Three, two, one, go!","vi":"Ba, hai, một, bắt đầu!"}]},{"word":"invite","ipa":"/ˌɪnˈvaɪt/","meaning":"mời","emoji":"📨","class":"v","examples":[{"en":"I invite my friends.","vi":"Tôi mời các bạn."},{"en":"She invites me to her party.","vi":"Cô ấy mời tôi đến tiệc."}]},{"word":"celebrate","ipa":"/ˈseləˌbreɪt/","meaning":"ăn mừng","emoji":"🎊","class":"v","examples":[{"en":"We celebrate my birthday.","vi":"Chúng tôi ăn mừng sinh nhật của tôi."},{"en":"Let's celebrate!","vi":"Cùng ăn mừng nào!"}]},{"word":"wish","ipa":"/wɪʃ/","meaning":"điều ước/chúc","emoji":"🌠","class":"n","examples":[{"en":"I make a wish.","vi":"Tôi ước một điều."},{"en":"My wish comes true.","vi":"Điều ước của tôi trở thành sự thật."}]},{"word":"balloon","ipa":"/bəˈlun/","meaning":"bóng bay","emoji":"🎈","class":"n","examples":[{"en":"I have a red balloon.","vi":"Tôi có một quả bóng bay đỏ."},{"en":"The balloon flies up.","vi":"Quả bóng bay lên."}]}]}