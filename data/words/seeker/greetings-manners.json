{"id":"greetings-manners","name":"Chào Hỏi & Lễ Phép","emoji":"🤝","color":"green","words":[{"word":"hello","meaning":"xin chào","emoji":"👋","examples":[{"en":"Hello! My name is Lan.","vi":"Xin chào! Tên tôi là Lan."},{"en":"Hello, teacher!","vi":"Xin chào thầy/cô!"}]},{"word":"bye","meaning":"tạm biệt","emoji":"✌️","examples":[{"en":"Bye! See you tomorrow.","vi":"Tạm biệt! Hẹn gặp lại nhé."},{"en":"Bye bye, grandma!","vi":"Tạm biệt bà!"}]},{"word":"please","meaning":"làm ơn","emoji":"🙏","examples":[{"en":"Water please.","vi":"Cho tôi nước, làm ơn."},{"en":"Please sit down.","vi":"Làm ơn ngồi xuống."}]},{"word":"sorry","meaning":"xin lỗi","emoji":"😔","examples":[{"en":"Sorry, I am late.","vi":"Xin lỗi, tôi đến muộn."},{"en":"I am sorry.","vi":"Tôi xin lỗi."}]},{"word":"welcome","meaning":"không có gì / chào mừng","emoji":"🫶","examples":[{"en":"You are welcome.","vi":"Không có gì."},{"en":"Welcome to my home!","vi":"Chào mừng đến nhà tôi!"}]},{"word":"yes","meaning":"có / vâng","emoji":"✅","class":"adv","examples":[{"en":"Yes, I can do it.","vi":"Vâng, tôi làm được."},{"en":"Yes, that is right.","vi":"Đúng vậy."}]},{"word":"no","meaning":"không","emoji":"❌","class":"adv","examples":[{"en":"No, I do not want that.","vi":"Không, tôi không muốn."},{"en":"No, thank you.","vi":"Không, cảm ơn."}]},{"word":"help","meaning":"giúp đỡ","emoji":"🆘","class":"v","examples":[{"en":"Help me please.","vi":"Làm ơn giúp tôi với."},{"en":"I help my mum.","vi":"Tôi giúp mẹ."}]},{"word":"thank","meaning":"cảm ơn","emoji":"🤗","examples":[{"en":"Thank you very much.","vi":"Cảm ơn rất nhiều."},{"en":"Thank you for the gift.","vi":"Cảm ơn vì món quà."}]},{"word":"name","meaning":"tên","emoji":"📛","class":"n","examples":[{"en":"My name is Lan.","vi":"Tên tôi là Lan."},{"en":"What is your name?","vi":"Tên bạn là gì?"}]},{"word":"meet","meaning":"gặp gỡ","emoji":"🤝","class":"v","examples":[{"en":"Nice to meet you.","vi":"Rất vui được gặp bạn."},{"en":"I meet my friends.","vi":"Tôi gặp các bạn."}