{"id":"weather-basic","name":"Thời Tiết","emoji":"⛅","color":"sky","words":[{"word":"sun","ipa":"/sʌn/","meaning":"mặt trời","emoji":"☀️","class":"n","examples":[{"en":"The sun is bright today.","vi":"Mặt trời rất sáng hôm nay."},{"en":"I play in the sun.","vi":"Tôi chơi dưới nắng."}]},{"word":"rain","ipa":"/reɪn/","meaning":"mưa","emoji":"🌧️","class":"n","examples":[{"en":"I hear the rain.","vi":"Tôi nghe thấy tiếng mưa."},{"en":"It rains today.","vi":"Hôm nay trời mưa."}]},{"word":"cloud","ipa":"/klaʊd/","meaning":"mây","emoji":"☁️","class":"n","examples":[{"en":"I see a big white cloud.","vi":"Tôi thấy một đám mây trắng to."},{"en":"The cloud is in the sky.","vi":"Đám mây ở trên bầu trời."}]},{"word":"wind","ipa":"/waɪnd/","meaning":"gió","emoji":"💨","class":"n","examples":[{"en":"The wind is strong today.","vi":"Hôm nay gió thổi rất mạnh."},{"en":"The wind blows my hat away.","vi":"Gió thổi bay mũ của tôi."}]},{"word":"snow","ipa":"/snoʊ/","meaning":"tuyết","emoji":"❄️","class":"n","examples":[{"en":"I see snow outside.","vi":"Tôi thấy tuyết bên ngoài."},{"en":"Snow is cold and white.","vi":"Tuyết thì lạnh và màu trắng."}]},{"word":"hot","ipa":"/hɑt/","meaning":"nóng","emoji":"🌡️","class":"adj","examples":[{"en":"It is hot today.","vi":"Hôm nay trời nóng."},{"en":"The soup is very hot.","vi":"Bát súp rất nóng."}]},{"word":"cold","ipa":"/koʊld/","meaning":"lạnh","emoji":"🥶","class":"adj","examples":[{"en":"It is cold today.","vi":"Hôm nay trời lạnh."},{"en":"The water is very cold.","vi":"Nước lạnh lắm."}]},{"word":"wet","ipa":"/wet/","meaning":"ướt","emoji":"🌂","class":"adj","examples":[{"en":"My shoes are wet.","vi":"Giày của tôi bị ướt."},{"en":"The grass is wet.","vi":"Cỏ bị ướt."}]},{"word":"dry","ipa":"/draɪ/","meaning":"khô","emoji":"🏜️","class":"adj","examples":[{"en":"My clothes are dry now.","vi":"Quần áo của tôi đã khô rồi."},{"en":"The ground is dry.","vi":"Mặt đất khô ráo."}]},{"word":"storm","ipa":"/stɔrm/","meaning":"bão","emoji":"⛈️","class":"n","examples":[{"en":"There is a big storm.","vi":"Có một cơn bão lớn."},{"en":"I stay home in a storm.","vi":"Tôi ở nhà khi có bão."}]},{"word":"fog","ipa":"/fɑɡ/","meaning":"sương mù","emoji":"🌫️","class":"n","examples":[{"en":"There is fog this morning.","vi":"Sáng nay có sương mù."},{"en":"I can not see in the fog.","vi":"Tôi không thấy gì trong sương mù."}]},{"word":"warm","ipa":"/wɔrm/","meaning":"ấm áp","emoji":"🌞","class":"adj","examples":[{"en":"It is warm today.","vi":"Hôm nay trời ấm áp."},{"en":"The sun makes me warm.","vi":"Mặt trời làm tôi ấm áp."}]},{"word":"cool","ipa":"/kul/","meaning":"mát mẻ","emoji":"🌬️","class":"adj","examples":[{"en":"The breeze is cool.","vi":"Làn gió mát mẻ quá."},{"en":"It is cool in the morning.","vi":"Buổi sáng trời mát mẻ."}]},{"word":"ice","ipa":"/aɪs/","meaning":"băng đá","emoji":"🧊","class":"n","examples":[{"en":"I put ice in my drink.","vi":"Tôi bỏ đá vào nước uống."},{"en":"Ice is very cold.","vi":"Đá lạnh lắm."}]},{"word":"rainbow","ipa":"/ˈreɪnˌboʊ/","meaning":"cầu vồng","emoji":"🌈","class":"n","examples":[{"en":"I see a rainbow after rain.","vi":"Tôi thấy cầu vồng sau cơn mưa."},{"en":"The rainbow has many colors.","vi":"Cầu vồng có nhiều màu sắc."}]}]}