{"id":"sea-creatures","name":"Sinh Vật Biển","emoji":"🌊","color":"blue","words":[{"word":"shark","ipa":"/ʃɑrk/","meaning":"cá mập","emoji":"🦈","class":"n","examples":[{"en":"The shark is in the sea.","vi":"Cá mập ở trong biển."},{"en":"Sharks swim very fast.","vi":"Cá mập bơi rất nhanh."}]},{"word":"whale","ipa":"/weɪl/","meaning":"cá voi","emoji":"🐋","class":"n","examples":[{"en":"The whale is very big.","vi":"Con cá voi rất to."},{"en":"Whales live in the ocean.","vi":"Cá voi sống ở đại dương."}]},{"word":"dolphin","ipa":"/ˈdɑlfən/","meaning":"cá heo","emoji":"🐬","class":"n","examples":[{"en":"Dolphins are very smart.","vi":"Cá heo rất thông minh."},{"en":"I see a dolphin jump.","vi":"Tôi thấy cá heo nhảy lên."}]},{"word":"crab","ipa":"/kræb/","meaning":"cua","emoji":"🦀","class":"n","examples":[{"en":"The crab has big claws.","vi":"Con cua có càng to."},{"en":"Crabs walk sideways.","vi":"Cua bò ngang."}]},{"word":"turtle","ipa":"/ˈtɜrtəl/","meaning":"rùa biển","emoji":"🐢","class":"n","examples":[{"en":"The turtle swims slowly.","vi":"Con rùa bơi chậm chậm."},{"en":"Turtles have hard shells.","vi":"Rùa có mai cứng."}]},{"word":"jellyfish","ipa":"/ˈdʒeliˌfɪʃ/","meaning":"sứa","emoji":"🪼","class":"n","examples":[{"en":"The jellyfish is in the sea.","vi":"Con sứa ở trong biển."},{"en":"Jellyfish can sting.","vi":"Sứa có thể đốt."}]},{"word":"octopus","ipa":"/ˈɑktəˌpʊs/","meaning":"bạch tuộc","emoji":"🐙","class":"n","examples":[{"en":"The octopus has eight arms.","vi":"Con bạch tuộc có tám xúc tu."},{"en":"Octopus can change color.","vi":"Bạch tuộc có thể đổi màu."}]},{"word":"lobster","ipa":"/ˈlɑbstər/","meaning":"tôm hùm","emoji":"🦞","class":"n","examples":[{"en":"The lobster is red.","vi":"Con tôm hùm màu đỏ."},{"en":"Lobsters live in the sea.","vi":"Tôm hùm sống dưới biển."}]},{"word":"starfish","ipa":"/ˈstɑrˌfɪʃ/","meaning":"sao biển","emoji":"⭐","class":"n","examples":[{"en":"The starfish has five arms.","vi":"Con sao biển có năm cánh."},{"en":"Starfish live on t