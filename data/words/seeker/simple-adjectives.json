{"id":"simple-adjectives","name":"Tính Từ Cơ Bản","emoji":"✨","color":"purple","words":[{"word":"big","ipa":"/bɪɡ/","meaning":"to/lớn","emoji":"🦣","class":"adj","examples":[{"en":"The elephant is big.","vi":"Con voi rất to."},{"en":"I want a big piece.","vi":"Tôi muốn một miếng to."}]},{"word":"small","ipa":"/smɔl/","meaning":"nhỏ","emoji":"🐭","class":"adj","examples":[{"en":"The mouse is small.","vi":"Con chuột rất nhỏ."},{"en":"I have a small bag.","vi":"Tôi có một cái túi nhỏ."}]},{"word":"tall","ipa":"/tɔl/","meaning":"cao","emoji":"🗼","class":"adj","examples":[{"en":"The giraffe is tall.","vi":"Hươu cao cổ rất cao."},{"en":"My dad is tall.","vi":"Bố tôi rất cao."}]},{"word":"short","ipa":"/ʃɔrt/","meaning":"thấp/ngắn","emoji":"🤏","class":"adj","examples":[{"en":"She is short.","vi":"Cô ấy rất thấp."},{"en":"The pencil is short.","vi":"Cây bút chì ngắn."}]},{"word":"long","ipa":"/lɔŋ/","meaning":"dài","emoji":"📏","class":"adj","examples":[{"en":"The snake is long.","vi":"Con rắn rất dài."},{"en":"She has long hair.","vi":"Cô ấy có tóc dài."}]},{"word":"new","ipa":"/nu/","meaning":"mới","emoji":"🆕","class":"adj","examples":[{"en":"I have new shoes.","vi":"Tôi có đôi giày mới."},{"en":"This is a new book.","vi":"Đây là quyển sách mới."}]},{"word":"old","ipa":"/oʊld/","meaning":"cũ/già","emoji":"🕰️","class":"adj","examples":[{"en":"That is an old book.","vi":"Đó là quyển sách cũ."},{"en":"My grandpa is old.","vi":"Ông tôi đã già."}]},{"word":"fast","ipa":"/fæst/","meaning":"nhanh","emoji":"🐆","class":"adj","examples":[{"en":"The cheetah is fast.","vi":"Con báo rất nhanh."},{"en":"Run fast!","vi":"Chạy nhanh lên!"}]},{"word":"slow","ipa":"/sloʊ/","meaning":"chậm","emoji":"🐌","class":"adj","examples":[{"en":"The snail is slow.","vi":"Con ốc sên rất chậm."},{"en":"Walk slowly.","vi":"Đi chậm thôi."}]},{"word":"clean","ipa":"/klin/","meaning":"sạch","emoji":"✨","class":"adj","examples":[{"en":"My hands are clean.","vi":"Tay tôi sạch rồi."},{"en":"Keep your room clean.","vi":"Giữ phòng sạch sẽ nhé."}]},{"word":"dirty","ipa":"/ˈdɜrti/","meaning":"bẩn","emoji":"🤢","class":"adj","examples":[{"en":"My shoes are dirty.","vi":"Giày tôi bẩn rồi."},{"en":"Wash your dirty hands.","vi":"Rửa tay bẩn đi."}]},{"word":"soft","ipa":"/sɑft/","meaning":"mềm","emoji":"🪶","class":"adj","examples":[{"en":"The teddy is soft.","vi":"Gấu bông rất mềm."},{"en":"The bed is soft.","vi":"Chiếc giường mềm lắm."}]},{"word":"hard","ipa":"/hɑrd/","meaning":"cứng","emoji":"💎","class":"adj","examples":[{"en":"The rock is hard.","vi":"Hòn đá rất cứng."},{"en":"This bread is hard.","vi":"Cái bánh mì này cứng quá."}]},{"word":"sweet","ipa":"/swit/","meaning":"ngọt","emoji":"🍬","class":"adj","examples":[{"en":"The cake is sweet.","vi":"Cái bánh rất ngọt."},{"en":"I like sweet things.","vi":"Tôi thích đồ ngọt."}]},{"word":"sour","ipa":"/ˈsaʊər/","meaning":"chua","emoji":"😝","class":"adj","examples":[{"en":"The lemon is sour.","vi":"Quả chanh rất chua."},{"en":"That is too sour.","vi":"Cái đó chua quá."}]}]}