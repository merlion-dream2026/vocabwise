{"id":"simple-feelings","name":"Cảm Xúc","emoji":"😊","color":"yellow","words":[{"word":"happy","meaning":"vui vẻ","emoji":"😊","class":"adj","examples":[{"en":"I am happy today.","vi":"Hôm nay tôi rất vui."},{"en":"The baby is happy.","vi":"Em bé rất vui vẻ."}]},{"word":"sad","meaning":"buồn","emoji":"😢","class":"adj","examples":[{"en":"I am sad today.","vi":"Hôm nay tôi buồn."},{"en":"She is sad and cries.","vi":"Cô ấy buồn và khóc."}]},{"word":"angry","meaning":"tức giận","emoji":"😠","class":"adj","examples":[{"en":"He is very angry.","vi":"Anh ấy rất tức giận."},{"en":"I am angry at my brother.","vi":"Tôi tức giận với em trai."}]},{"word":"scared","meaning":"sợ hãi","emoji":"😨","class":"adj","examples":[{"en":"I am scared of the dark.","vi":"Tôi sợ bóng tối."},{"en":"The cat is scared.","vi":"Con mèo sợ hãi."}]},{"word":"tired","meaning":"mệt mỏi","emoji":"🥱","class":"adj","examples":[{"en":"I am tired after school.","vi":"Tôi mệt sau khi đi học."},{"en":"She is very tired.","vi":"Cô ấy rất mệt."}]},{"word":"hungry","meaning":"đói bụng","emoji":"🤤","class":"adj","examples":[{"en":"I am hungry now.","vi":"Tôi đang đói."},{"en":"The dog is hungry.","vi":"Con chó đang đói."}]},{"word":"funny","meaning":"buồn cười","emoji":"😄","class":"adj","examples":[{"en":"The clown is funny.","vi":"Chú hề rất buồn cười."},{"en":"That story is funny.","vi":"Câu chuyện đó buồn cười lắm."}]},{"word":"good","meaning":"tốt","emoji":"👍","class":"adj","examples":[{"en":"This food is good.","vi":"Thức ăn này rất ngon."},{"en":"I am a good student.","vi":"Tôi là một học sinh tốt."}]},{"word":"bad","meaning":"xấu/tệ","emoji":"👎","class":"adj","examples":[{"en":"This is a bad day.","vi":"Hôm nay là một ngày tệ."},{"en":"That smell is bad.","vi":"Mùi đó rất khó chịu."}]},{"word":"okay","meaning":"ổn","emoji":"👌","class":"adj","examples":[{"en":"I am okay now.","vi":"Bây giờ tôi ổn rồi."},{"en":"Is that okay with you?","vi":"Điều đó có ổn với bạn không?"}]}]}