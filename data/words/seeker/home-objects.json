{"id":"home-objects","name":"Đồ Dùng Trong Bếp","emoji":"🍳","color":"orange","words":[{"word":"spoon","ipa":"/spun/","meaning":"thìa/muỗng","emoji":"🥄","class":"n","examples":[{"en":"I eat soup with a spoon.","vi":"Tôi ăn súp bằng thìa."},{"en":"Give me a spoon please.","vi":"Cho tôi một cái thìa."}]},{"word":"fork","ipa":"/fɔrk/","meaning":"nĩa","emoji":"🍴","class":"n","examples":[{"en":"I eat salad with a fork.","vi":"Tôi ăn salad bằng nĩa."},{"en":"Pass me the fork.","vi":"Đưa cho tôi cái nĩa."}]},{"word":"knife","ipa":"/naɪf/","meaning":"dao","emoji":"🔪","class":"n","examples":[{"en":"Mum cuts with a knife.","vi":"Mẹ cắt bằng con dao."},{"en":"Be careful with the knife.","vi":"Cẩn thận với con dao nhé."}]},{"word":"plate","ipa":"/pleɪt/","meaning":"đĩa","emoji":"🍽️","class":"n","examples":[{"en":"I put food on my plate.","vi":"Tôi để thức ăn vào đĩa."},{"en":"The plate is white.","vi":"Cái đĩa màu trắng."}]},{"word":"bowl","ipa":"/boʊl/","meaning":"bát/tô","emoji":"🥣","class":"n","examples":[{"en":"I eat rice in a bowl.","vi":"Tôi ăn cơm trong bát."},{"en":"The bowl is full of soup.","vi":"Bát đầy canh."}]},{"word":"glass","ipa":"/ɡlæs/","meaning":"ly thủy tinh","emoji":"🥃","class":"n","examples":[{"en":"I drink water from a glass.","vi":"Tôi uống nước từ cái ly."},{"en":"The glass is clear.","vi":"Cái ly trong suốt."}]},{"word":"pot","ipa":"/pɑt/","meaning":"nồi","emoji":"🫕","class":"n","examples":[{"en":"Mum cooks in the pot.","vi":"Mẹ nấu trong cái nồi."},{"en":"The pot is hot.","vi":"Cái nồi rất nóng."}]},{"word":"pan","ipa":"/pæn/","meaning":"chảo","emoji":"🍳","class":"n","examples":[{"en":"Mum fries eggs in the pan.","vi":"Mẹ rán trứng trong chảo."},{"en":"The pan is on the stove.","vi":"Cái chảo ở trên bếp."}]},{"word":"towel","ipa":"/ˈtaʊəl/","meaning":"khăn tắm","emoji":"🧺","class":"n","examples":[{"en":"I dry with a towel.","vi":"Tôi lau khô bằng khăn."},{"en":"My towel is blue.","vi":"Khăn tắm của tôi màu xanh."}]},{"word":"soap","ipa":"/soʊp/","meani