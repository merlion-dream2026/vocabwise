{"id":"household-items","name":"Trong Nhà","emoji":"🏠","color":"teal","words":[{"word":"door","meaning":"cửa ra vào","emoji":"🚪","class":"n","examples":[{"en":"Please open the door.","vi":"Làm ơn mở cửa ra."},{"en":"The door is big and brown.","vi":"Cánh cửa to và màu nâu."}]},{"word":"window","meaning":"cửa sổ","emoji":"🪟","class":"n","examples":[{"en":"I look out the window.","vi":"Tôi nhìn ra ngoài cửa sổ."},{"en":"Open the window please.","vi":"Mở cửa sổ ra đi."}]},{"word":"bed","meaning":"giường","emoji":"🛏️","class":"n","examples":[{"en":"I sleep in my bed.","vi":"Tôi ngủ trên giường."},{"en":"My bed is soft.","vi":"Chiếc giường của tôi rất mềm."}]},{"word":"sofa","meaning":"ghế sofa","emoji":"🛋️","class":"n","examples":[{"en":"I sit on the sofa.","vi":"Tôi ngồi trên ghế sofa."},{"en":"The sofa is very soft.","vi":"Ghế sofa rất mềm."}]},{"word":"lamp","meaning":"đèn","emoji":"💡","class":"n","examples":[{"en":"Turn on the lamp please.","vi":"Bật đèn lên đi."},{"en":"The lamp gives light.","vi":"Cái đèn chiếu sáng."}]},{"word":"floor","meaning":"sàn nhà","emoji":"🪵","class":"n","examples":[{"en":"I sit on the floor.","vi":"Tôi ngồi trên sàn nhà."},{"en":"The floor is clean.","vi":"Sàn nhà rất sạch."}]},{"word":"wall","meaning":"bức tường","emoji":"🧱","class":"n","examples":[{"en":"I hang a picture on the wall.","vi":"Tôi treo tranh lên tường."},{"en":"The wall is white.","vi":"Bức tường màu trắng."}]},{"word":"kitchen","meaning":"nhà bếp","emoji":"🥘","class":"n","examples":[{"en":"Mum cooks in the kitchen.","vi":"Mẹ nấu ăn trong bếp."},{"en":"The kitchen smells good.","vi":"Nhà bếp thơm mùi đồ ăn."}]},{"word":"bathroom","meaning":"phòng tắm","emoji":"🚿","class":"n","examples":[{"en":"I wash in the bathroom.","vi":"Tôi tắm trong phòng tắm."},{"en":"The bathroom is small.","vi":"Phòng tắm nhỏ."}]},{"word":"garden","meaning":"vườn","emoji":"🌻","class":"n","examples":[{"en":"I play in the garden.","vi":"Tôi chơi trong vườn."},{"en":"The garden has many flowers.","vi":"Khu vườn có nhiều hoa."}]},{"word":"stairs","meaning":"cầu thang","emoji":"🪜","class":"n","examples":[{"en":"I walk up the stairs.","vi":"Tôi đi lên cầu thang."},{"en":"Be careful on the stairs.","vi":"Cẩn thận khi đi cầu thang nhé."}]},{"word":"shelf","meaning":"kệ sách","emoji":"📚","class":"n","examples":[{"en":"I put my books on the shelf.","vi":"Tôi để sách lên kệ."},{"en":"The shelf is full of books.","vi":"Kệ sách đầy sách."}]},{"word":"mirror","meaning":"gương","emoji":"🪞","class":"n","examples":[{"en":"I look in the mirror.","vi":"Tôi nhìn vào gương."},{"en":"The mirror is big.","vi":"Cái gương rất to."}]},{"word":"clock","meaning":"đồng hồ","emoji":"🕐","class":"n","examples":[{"en":"The clock is on the wall.","vi":"Đồng hồ treo trên tường."},{"en":"The clock says eight.","vi":"Đồng hồ chỉ tám giờ."}]},{"word":"cup","meaning":"cốc/ly","emoji":"☕","class":"n","examples":[{"en":"I drink from my cup.","vi":"Tôi uống từ cái cốc."},{"en":"The cup is full of water.","vi":"Cái cốc đầy nước."}]}]}