{"id":"outdoor-play","name":"Vui Chơi Ngoài Trời","emoji":"🌳","color":"green","words":[{"word":"park","meaning":"công viên","emoji":"🏕️","class":"n","examples":[{"en":"I play in the park.","vi":"Tôi chơi trong công viên."},{"en":"The park is green.","vi":"Công viên xanh mướt."}]},{"word":"slide","meaning":"cầu trượt","emoji":"🛝","class":"n","examples":[{"en":"I go down the slide.","vi":"Tôi trượt xuống cầu trượt."},{"en":"The slide is tall.","vi":"Cầu trượt rất cao."}]},{"word":"swing","meaning":"xích đu","emoji":"🎠","class":"n","examples":[{"en":"I sit on the swing.","vi":"Tôi ngồi trên xích đu."},{"en":"Push me on the swing!","vi":"Đẩy xích đu cho tôi!"}]},{"word":"climb","meaning":"leo trèo","emoji":"🧗","class":"v","examples":[{"en":"I climb the tree.","vi":"Tôi leo lên cây."},{"en":"Climb up!","vi":"Leo lên nào!"}]},{"word":"hide","meaning":"trốn","emoji":"🙈","class":"v","examples":[{"en":"I hide behind the tree.","vi":"Tôi trốn sau gốc cây."},{"en":"Hide and seek!","vi":"Trốn tìm nào!"}]},{"word":"seek","meaning":"tìm","emoji":"🔍","class":"v","examples":[{"en":"I seek my friends.","vi":"Tôi tìm các bạn."},{"en":"I seek you!","vi":"Tôi sẽ tìm bạn!"}]},{"word":"race","meaning":"chạy đua","emoji":"🏁","class":"n","examples":[{"en":"Let's have a race!","vi":"Chạy đua nào!"},{"en":"I win the race.","vi":"Tôi thắng cuộc đua."}]},{"word":"catch","meaning":"bắt","emoji":"🤲","class":"v","examples":[{"en":"I catch the ball.","vi":"Tôi bắt quả bóng."},{"en":"Catch me!","vi":"Bắt tôi đi!"}]},{"word":"dig","meaning":"đào","emoji":"⛏️","class":"v","examples":[{"en":"I dig in the sand.","vi":"Tôi đào trong cát."},{"en":"Dogs dig holes.","vi":"Chó đào hố."}]},{"word":"splash","meaning":"té nước","emoji":"💦","class":"v","examples":[{"en":"I splash in the water.","vi":"Tôi té nước."},{"en":"Don't splash me!","vi":"Đừng té nước vào tôi!"}]},{"word":"skip","meaning":"nhảy dây","emoji":"🪢","class":"v","examples":[{"en":"I skip rope.","vi":"Tôi nhảy dây."},{"en":"Skip to the tree.","