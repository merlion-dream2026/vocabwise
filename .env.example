# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-random-32+-char-secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Legacy SMTP fallback (optional)
# GMAIL_USER=your@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# ── AI / Speech ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx          # optional, if used
ELEVENLABS_API_KEY=sk_xxxxxxxx      # optional, TTS
ELEVENLABS_VOICE_ID=your-voice-id   # optional, TTS

# ── Redis (Upstash) — rate limiting & caching ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@vocabwise.id.vn

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=your-random-secret         # Bearer token for /api/cron/* routes

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vocabwise.id.vn
ADMIN_ALERT_EMAIL=your-admin@email.com  # receives login alerts
